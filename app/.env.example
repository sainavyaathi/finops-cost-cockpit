# FinOps Cost Cockpit settings. The app reads environment variables only; this file is a reference.
# Copy the lines you need into your shell or a .env loader. Never commit real tokens.

# --- Data source -------------------------------------------------------------
# local = CSVs from the sandbox run, databricks = SQL warehouse, or a kind registered by a plugin.
COCKPIT_SOURCE=local
# Folder of <table>.csv files (local only). Default: sandbox/local_output
# COCKPIT_LOCAL_DIR=sandbox/local_output
# Comma-separated modules that call datasource.register_source(...) for extra backends.
# COCKPIT_SOURCE_PLUGINS=my_company.cockpit_snowflake

# --- Where the gold tables live -------------------------------------------------
COCKPIT_CATALOG=workspace
COCKPIT_SCHEMA=cockpit
# Optional per-table overrides (YAML). Default: app/tables.yaml if it exists.
# COCKPIT_TABLE_MAP=/path/to/tables.yaml

# --- Databricks SQL warehouse ---------------------------------------------------
# DATABRICKS_WAREHOUSE_ID=1234567890abcdef
# Or an explicit HTTP path instead of the warehouse id:
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/1234567890abcdef

# --- Auth (databricks) ----------------------------------------------------------
# auto (default): app inside Databricks Apps, sdk elsewhere.
# app:  Databricks Apps service principal (DATABRICKS_CLIENT_ID/SECRET injected by Apps).
# user: on-behalf-of-user via the X-Forwarded-Access-Token header (Databricks Apps only).
# sdk:  whatever databricks-sdk resolves from the variables below.
COCKPIT_AUTH=auto
# Pick ONE of the following for sdk mode:
# 1) Personal access token
# DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_TOKEN=<set in your shell, never in a committed file>
# 2) CLI profile from ~/.databrickscfg (e.g. created by `databricks auth login`)
# DATABRICKS_CONFIG_PROFILE=DEFAULT
# 3) OAuth machine-to-machine (service principal)
# DATABRICKS_HOST=https://<workspace-host>
# DATABRICKS_CLIENT_ID=<service principal application id>
# DATABRICKS_CLIENT_SECRET=<set in your shell or CI secret store>
# 4) Azure: service principal (or `az login` for Azure CLI auth with just DATABRICKS_HOST)
# ARM_TENANT_ID=<tenant id>
# ARM_CLIENT_ID=<application id>
# ARM_CLIENT_SECRET=<set in your shell or CI secret store>
# DATABRICKS_AZURE_RESOURCE_ID=<workspace resource id, optional>
# 5) GCP: service account impersonation or a credentials JSON
# DATABRICKS_GOOGLE_SERVICE_ACCOUNT=<sa>@<project>.iam.gserviceaccount.com
# GOOGLE_CREDENTIALS=<path or JSON, from your secret store>

# --- Query behaviour ------------------------------------------------------------
# Statement timeout in seconds (0 = warehouse default).
COCKPIT_QUERY_TIMEOUT=300
# Optional row cap per table read, applied with LIMIT.
# COCKPIT_MAX_ROWS=200000

# --- Pages ------------------------------------------------------------------------
# COCKPIT_FEATURES_FILE=app/features.yaml
